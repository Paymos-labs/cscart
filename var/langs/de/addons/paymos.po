msgctxt "Addons::name::paymos"
msgid "Paymos Payments"
msgstr "Paymos Payments"

msgctxt "Addons::description::paymos"
msgid "Paymos hosted checkout payment processor."
msgstr "Zahlungsanbieter Paymos mit gehostetem Checkout."

msgctxt "Languages::paymos.mode"
msgid "Mode"
msgstr "Modus"

msgctxt "Languages::paymos.mode_sandbox"
msgid "Sandbox"
msgstr "Sandbox"

msgctxt "Languages::paymos.mode_live"
msgid "Live"
msgstr "Live"

msgctxt "Languages::paymos.mode_description"
msgid "Connect Paymos once, test in Sandbox, then switch to Live. Credentials are delivered securely after approval and are never included in the add-on package."
msgstr "Verbinden Sie Paymos einmal, testen Sie in der Sandbox und stellen Sie dann auf Live um. Die Zugangsdaten werden nach der Bestätigung sicher übertragen und liegen nie im Add-on-Paket."

msgctxt "Languages::paymos.pending_status"
msgid "Order status while awaiting payment (status code, e.g. O)"
msgstr "Bestellstatus, solange auf die Zahlung gewartet wird (Statuscode, z. B. O)"

msgctxt "Languages::paymos.paid_status"
msgid "Order status when paid (status code, e.g. P)"
msgstr "Bestellstatus bei bezahlter Rechnung (Statuscode, z. B. P)"

msgctxt "Languages::paymos.confirming_status"
msgid "Order status while the payment is confirming on-chain (status code)"
msgstr "Bestellstatus, solange die Zahlung on-chain bestätigt wird (Statuscode)"

msgctxt "Languages::paymos.failed_status"
msgid "Order status when the payment is underpaid (status code)"
msgstr "Bestellstatus bei unterbezahlter Zahlung (Statuscode)"

msgctxt "Languages::paymos.cancelled_status"
msgid "Order status when the invoice is cancelled or expired (status code)"
msgstr "Bestellstatus bei stornierter oder abgelaufener Rechnung (Statuscode)"

msgctxt "Languages::paymos.debug_logging"
msgid "Debug logging"
msgstr "Diagnoseprotokoll"

msgctxt "Languages::paymos.checkout_failed"
msgid "Paymos payment error: unable to create invoice."
msgstr "Paymos-Zahlungsfehler: Die Rechnung konnte nicht angelegt werden."

msgctxt "Languages::paymos.manual_review"
msgid "Paymos payment needs manual review."
msgstr "Paymos payment needs manual review."

msgctxt "Languages::paymos.replacement_blocked"
msgid "The store needs to review this order before payment can continue. Please contact the store."
msgstr "Bevor Sie weiter bezahlen können, muss der Shop diese Bestellung prüfen. Bitte wenden Sie sich an den Shop."

msgctxt "Languages::paymos.refund_order"
msgid "Order"
msgstr "Bestellung"


msgctxt "Languages::paymos.refund_full"
msgid "Full refund"
msgstr "Vollständige Erstattung"


msgctxt "Languages::paymos.refund_overpayment"
msgid "Overpayment refund"
msgstr "Erstattung der Überzahlung"


msgctxt "Languages::paymos.refund_recipient"
msgid "Recipient"
msgstr "Empfänger"


msgctxt "Languages::paymos.refund_full_action"
msgid "Refund in full"
msgstr "Vollständig erstatten"


msgctxt "Languages::paymos.refund_overpayment_action"
msgid "Refund overpayment"
msgstr "Überzahlung erstatten"


msgctxt "Languages::paymos.refund_type"
msgid "Type"
msgstr "Art"


msgctxt "Languages::paymos.refund_transfer_record"
msgid "Transfer / record"
msgstr "Überweisung / Buchung"


msgctxt "Languages::paymos.refund_amount"
msgid "Amount"
msgstr "Betrag"


msgctxt "Languages::paymos.refund_order_total"
msgid "Order total"
msgstr "Bestellsumme"


msgctxt "Languages::paymos.refund_reason"
msgid "Reason"
msgstr "Grund"


msgctxt "Languages::paymos.refund_check_full"
msgid "Check full refund"
msgstr "Vollständige Erstattung prüfen"


msgctxt "Languages::paymos.refund_check_overpayment"
msgid "Check overpayment refund"
msgstr "Erstattung der Überzahlung prüfen"


msgctxt "Languages::paymos.refund_external"
msgid "Refund made outside CS-Cart"
msgstr "Erstattung außerhalb von CS-Cart"


msgctxt "Languages::paymos.refunds"
msgid "Paymos refunds"
msgstr "Paymos-Erstattungen"


msgctxt "Languages::paymos.refund_unavailable"
msgid "Refunds through Paymos are not available for this order right now. If this happens on every order, reconnect the add-on with Connect Paymos in the payment method settings."
msgstr "Für diese Bestellung ist derzeit keine Erstattung über Paymos möglich. Betrifft dies alle Bestellungen, verbinden Sie das Add-on in den Einstellungen der Zahlungsart erneut mit Paymos."


msgctxt "Languages::paymos.refunds_open_failed"
msgid "Paymos refunds cannot be opened for this order. Check that the order ID is right and the order uses the Paymos payment method."
msgstr "Die Paymos-Erstattungen für diese Bestellung konnten nicht geöffnet werden. Prüfen Sie die Bestellnummer und ob Paymos als Zahlungsart verwendet wird."


msgctxt "Languages::paymos.refund_request_failed"
msgid "The refund request did not complete; the reason is in the PHP error log. Check the refunds on this order before you try again."
msgstr "Die Erstattungsanfrage wurde nicht abgeschlossen. Details stehen im PHP-Fehlerprotokoll. Prüfen Sie die Erstattungen dieser Bestellung, bevor Sie es erneut versuchen."


msgctxt "Languages::paymos.refund_check_failed"
msgid "The refund status could not be checked; the reason is in the PHP error log. Try again later."
msgstr "Der Erstattungsstatus konnte nicht geprüft werden. Details stehen im PHP-Fehlerprotokoll. Versuchen Sie es später erneut."


msgctxt "Languages::paymos.refund_reconnect_required"
msgid "Refunds through Paymos are not available on the current connection. Reconnect the add-on with Connect Paymos in the payment method settings, then try again."
msgstr "Über die aktuelle Verbindung sind keine Paymos-Erstattungen möglich. Verbinden Sie das Add-on in den Einstellungen der Zahlungsart erneut mit Paymos und versuchen Sie es noch einmal."
