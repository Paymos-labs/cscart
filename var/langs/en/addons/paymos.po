msgctxt "Languages::paymos.refunds"
msgid "Paymos refunds"
msgstr "Paymos refunds"


msgctxt "Languages::paymos.refund_unavailable"
msgid "Refunds through Paymos are not available for this order right now. If this happens on every order, reconnect the add-on with Connect Paymos in the payment method settings."
msgstr "Refunds through Paymos are not available for this order right now. If this happens on every order, reconnect the add-on with Connect Paymos in the payment method settings."


msgctxt "Languages::paymos.refunds_open_failed"
msgid "Paymos refunds cannot be opened for this order. Check that the order ID is right and the order uses the Paymos payment method."
msgstr "Paymos refunds cannot be opened for this order. Check that the order ID is right and the order uses the Paymos payment method."


msgctxt "Languages::paymos.refund_request_failed"
msgid "The refund request did not complete; the reason is in the PHP error log. Check the refunds on this order before you try again."
msgstr "The refund request did not complete; the reason is in the PHP error log. Check the refunds on this order before you try again."


msgctxt "Languages::paymos.refund_check_failed"
msgid "The refund status could not be checked; the reason is in the PHP error log. Try again later."
msgstr "The refund status could not be checked; the reason is in the PHP error log. Try again later."


msgctxt "Languages::paymos.refund_reconnect_required"
msgid "Refunds through Paymos are not available on the current connection. Reconnect the add-on with Connect Paymos in the payment method settings, then try again."
msgstr "Refunds through Paymos are not available on the current connection. Reconnect the add-on with Connect Paymos in the payment method settings, then try again."
