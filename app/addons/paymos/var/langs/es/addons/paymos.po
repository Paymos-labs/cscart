msgctxt "Addons::name::paymos"
msgid "Paymos Payments"
msgstr "Paymos Payments"

msgctxt "Addons::description::paymos"
msgid "Paymos hosted checkout payment processor."
msgstr "Procesador de pagos Paymos con página de pago alojada."

msgctxt "Languages::paymos.mode"
msgid "Mode"
msgstr "Modo"

msgctxt "Languages::paymos.mode_sandbox"
msgid "Sandbox"
msgstr "Sandbox"

msgctxt "Languages::paymos.mode_live"
msgid "Live"
msgstr "Live"

msgctxt "Languages::paymos.mode_description"
msgid "Connect Paymos once, test in Sandbox, then switch to Live. Credentials are delivered securely after approval and are never included in the add-on package."
msgstr "Conecta Paymos una vez, prueba en Sandbox y cambia a Live. Las credenciales se entregan de forma segura tras la aprobación y nunca viajan dentro del paquete del add-on."

msgctxt "Languages::paymos.pending_status"
msgid "Order status while awaiting payment (status code, e.g. O)"
msgstr "Estado del pedido mientras se espera el pago (código de estado, p. ej. O)"

msgctxt "Languages::paymos.paid_status"
msgid "Order status when paid (status code, e.g. P)"
msgstr "Estado del pedido cuando está pagado (código de estado, p. ej. P)"

msgctxt "Languages::paymos.confirming_status"
msgid "Order status while the payment is confirming on-chain (status code)"
msgstr "Estado del pedido mientras el pago se confirma en la cadena (código de estado)"

msgctxt "Languages::paymos.failed_status"
msgid "Order status when the payment is underpaid (status code)"
msgstr "Estado del pedido cuando el pago es insuficiente (código de estado)"

msgctxt "Languages::paymos.cancelled_status"
msgid "Order status when the invoice is cancelled or expired (status code)"
msgstr "Estado del pedido cuando la factura se cancela o vence (código de estado)"

msgctxt "Languages::paymos.debug_logging"
msgid "Debug logging"
msgstr "Registro de diagnóstico"
